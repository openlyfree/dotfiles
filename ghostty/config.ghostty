font-size = 10
font-family = "Cascadia Code"
#font-style = "Med"
freetype-load-flags = false
adjust-cell-width = 0
adjust-cell-height = 0
theme = noctalia
background-opacity=1
confirm-close-surface = false
window-padding-color = extend
window-padding-x = 0
window-padding-y = 0
async-backend = io_uring
