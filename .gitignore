# ~/.config dotfiles repo
# Deny by default: ~/.config holds browser profiles, tokens, credentials, etc.
/*

# Keep this ignore file and Noctalia's config directory.
!/.gitignore
!/noctalia/

# Inside noctalia, ignore by default, then allow only curated files.
/noctalia/**

# Hand-written + GUI-managed Noctalia config.
!/noctalia/*.toml

# Internal app state can contain private runtime data - keep it out.
/noctalia/state.toml

# User palettes and templates.
!/noctalia/palettes/
!/noctalia/palettes/**
!/noctalia/templates/
!/noctalia/templates/**
!/noctalia/wallpapers/
!/noctalia/wallpapers/**

# App configs whose active theme is Noctalia.
!/bat/
!/bat/**
!/btop/
!/btop/**
!/cava/
!/cava/**
!/fzf/
!/fzf/**
!/ghostty/
!/ghostty/**
!/gtk-3.0/
!/gtk-3.0/**
!/gtk-4.0/
!/gtk-4.0/**
!/helix/
!/helix/**
# Qt5 theme is unused (QT_QPA_PLATFORMTHEME=qt6ct); the qt template regenerates it.
/qt5ct/
!/qt6ct/
!/qt6ct/**
!/sonora/
!/sonora/**
/sonora/sonora.backup.json
/sonora/themes/noctalia.json
!/strata/
!/strata/**
!/zed/
!/zed/**
!/kdeglobals

# Umbriel compositor config - this is what launches Noctalia.
!/umbriel/
!/umbriel/**
/umbriel/*.bak-*

# Personal/runtime leftovers that shouldn't be published.
/gtk-3.0/bookmarks
/strata/tabs.toml

# Extra safety net if the rules above are ever widened.
*.key
*.pem
*.crt
*token*
*secret*
*password*
